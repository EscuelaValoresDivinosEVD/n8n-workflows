    {
      "parameters": {
        "jsCode": "// n8n Code node - parse formatted \"value\" string into one item per row\n// Input field: items[x].json.value\n// Output: array of items [{ json: { index: <Number>, name: \"<string>\" } }, ...]\n\nconst output = [];\n\nfor (const it of items) {\n  const value = (it.json && it.json.value) ? String(it.json.value) : '';\n  if (!value) continue;\n\n  // find all occurrences of \"(number)\" and record their positions\n  const idxRegex = /\\(\\s*(\\d+)\\s*\\)/g;\n  const matches = [];\n  let m;\n  while ((m = idxRegex.exec(value)) !== null) {\n    matches.push({ index: parseInt(m[1], 10), start: m.index, end: idxRegex.lastIndex });\n  }\n\n  // if no markers found, skip this input item\n  if (matches.length === 0) continue;\n\n  // build rows: text after each marker until the next marker (or end of string)\n  for (let i = 0; i < matches.length; i++) {\n    const cur = matches[i];\n    const next = matches[i + 1];\n    let nameChunk = value.slice(cur.end, next ? next.start : value.length);\n\n    // remove leading/trailing separators (spaces, tabs, underscores, asterisks, pipes)\n    const name = nameChunk.replace(/^[\\s_*|]+/, '').replace(/[\\s_*|]+$/, '');\n\n    output.push({\n      json: {\n        index: cur.index,\n        name: name\n      }\n    });\n  }\n}\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
